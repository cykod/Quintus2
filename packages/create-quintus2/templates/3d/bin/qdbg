#!/usr/bin/env bash
set -euo pipefail

# qdbg — Quintus game engine debugger
# Ergonomic wrapper around playwright-cli for debugging running Quintus games.
# Uses a named playwright session "quintus" for persistence.

# ── Prerequisites ────────────────────────────────────────────────────────────

QROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

check_playwright_cli() {
	if ! command -v playwright-cli &>/dev/null; then
		cat >&2 <<'MSG'
Error: playwright-cli is not installed or not in PATH.

The qdbg debugger requires playwright-cli to control the browser.
Install it with:

  npm install -g @anthropic-ai/claude-code

Or if you have Claude Code installed, ensure its bin directory is in your PATH.

playwright-cli is bundled with Claude Code and provides persistent
browser sessions for programmatic page control.
MSG
		exit 1
	fi
}

# ── Usage / Help ─────────────────────────────────────────────────────────────

show_usage() {
	cat <<'USAGE'
qdbg — Quintus game engine debugger

Interactively debug any Quintus game from the terminal. Steps through
frames, inspects the scene tree, injects input, analyzes physics, and
captures screenshots — all via the engine's debug bridge.

PREREQUISITES
  1. playwright-cli must be installed (bundled with Claude Code)
  2. The Quintus dev server must be running: pnpm dev

QUICK START
  pnpm qdbg connect platformer     # Open game in browser, paused
  pnpm qdbg tree                   # See the scene tree
  pnpm qdbg step 60                # Advance 60 frames (1 second)
  pnpm qdbg physics Player         # Inspect player physics state
  pnpm qdbg tap jump 1             # Tap the jump button
  pnpm qdbg screenshot             # Save canvas to PNG
  pnpm qdbg disconnect             # Close browser

COMMANDS
  Connection:
    connect [demo|url]    Open browser with debug bridge (default: platformer)
    disconnect            Close browser session

  Inspection:
    status                Show frame number, elapsed time, paused state
    tree                  Formatted ASCII scene tree
    layout                Spatial overview with physics info
    inspect <name|id>     Detailed node snapshot (JSON)
    query <q>             Find nodes by type/name/tag
    physics <name>        Physics state summary for one node
    bones <name|id>       3D bone hierarchy tree with positions
    bone-info <name> <bone>  Detailed info for a specific bone
    transform <name|id>   3D local/world transform details
    camera                Active 3D camera info (FOV, aspect, position)
    lights                List all lights with type, intensity, color
    material <name|id>    Material info for a node's meshes
    stats                 Three.js renderer stats (draw calls, triangles)

  Scene:
    scene <name>          Switch to a registered scene by name
    scenes                List all registered scene names

  Simulation:
    step [N]              Advance N frames (default: 1)
    pause                 Pause game loop
    resume                Resume real-time game loop

  Input:
    actions               List available input actions
    press <action>        Press and hold an action
    release <action>      Release an action
    release-all           Release all held actions
    tap <action> [N]      Press for N frames then release (default: 1)
    click <x> <y>         Click at game-space coordinates
    click-button <text>   Click a UI button by name or text label

  Movement:
    move-to <node> <actions> <x> <y> [--max=N]
                          Hold action(s) until node reaches threshold
                          Use "-" for x or y to ignore that axis
    nearby <name> [rad]   Show nodes within radius (default: 100px)
    mouse <x> <y>         Set the mouse/pointer position (game-space coords)
    mouse-get             Get the current mouse/pointer position

  Scene modification:
    destroy <name|id|type|tag>
                          Remove node(s) from the scene tree. Matches by
                          node name, numeric id, constructor type, or tag.

  Scripting:
    eval '<code>'         Evaluate a JS expression in the browser and print the result
    run '<json>'          Execute a DebugAction[] script
    track <name> [N]      Step N frames with tabular tracking (default: 30)
    jump-analysis <name>  Full jump arc analysis with metrics

  Events:
    events [flags]        Drain events since last call
                          --category=  --search=  --limit=  --from=  --to=
    peek [flags]          View events without draining
    clear-events          Clear event log

  Capture:
    screenshot [file]     Save canvas to PNG (default: /tmp/quintus-screenshot.png)

COMMON ISSUES
  "Error: playwright-cli is not installed"
    → Install Claude Code (npm i -g @anthropic-ai/claude-code) which bundles it

  "Error: Debug bridge not found"
    → Run "qdbg connect" first. Every command except connect needs an active session.

  "Error: Dev server failed to start"
    → Run "pnpm dev" manually and check for errors

  "Node not found: Player"
    → Node names are case-sensitive. Run "qdbg tree" to see exact names.

EXAMPLES
  # Debug a custom example
  pnpm qdbg connect my-game

  # Connect to an arbitrary URL
  pnpm qdbg connect http://localhost:8080/game.html

  # Walk player right, jump, and check landing
  pnpm qdbg move-to Player move_right 250 -
  pnpm qdbg tap jump 1
  pnpm qdbg step 60
  pnpm qdbg physics Player

  # Run a scripted sequence
  pnpm qdbg run '[{"press":"move_right","frames":30},{"press":"jump","frames":1},{"wait":20}]'

  # Analyze jump physics
  pnpm qdbg jump-analysis Player

  # Filter events
  pnpm qdbg events --category=physics --search=floor
USAGE
}

# ── Session ──────────────────────────────────────────────────────────────────

SESSION="quintus"
PC="playwright-cli -s=${SESSION}"

# ── Helpers ──────────────────────────────────────────────────────────────────

qeval() {
	# Evaluate a simple JS expression in the browser (no blocks, no IIFE)
	$PC eval "$1"
}

qblock() {
	# Run a JS block (with return statements) in the browser via page.evaluate
	$PC run-code "async page => { return await page.evaluate(() => { $1 }); }"
}

qrun() {
	# Run an async function with full page access (for fs, screenshots, etc.)
	$PC run-code "$1"
}

die() { echo "Error: $*" >&2; exit 1; }

need_bridge() {
	qeval "typeof window.__quintusDebug !== 'undefined' ? 'ok' : 'no'" 2>/dev/null | grep -q "ok" \
		|| die "Debug bridge not found. Run: qdbg connect"
}

# ── Commands ─────────────────────────────────────────────────────────────────

# Append the ?debug query param (which installs the debug bridge) unless present.
append_debug() {
	local u="$1"
	if [[ "$u" != *"debug"* ]]; then
		if [[ "$u" == *"?"* ]]; then u="${u}&debug"; else u="${u}?debug"; fi
	fi
	echo "$u"
}

# Reject a navigation target that isn't an http(s) URL (file:, javascript:, data:,
# or a leading "-" that could be parsed as a playwright-cli flag). Guards the
# browser against being pointed at an arbitrary target by an untrusted .qdbg.json.
require_http_url() {
	case "$1" in
		http://*|https://*) : ;;
		*) die "Refusing to open non-http(s) URL: $1" ;;
	esac
}

# A .qdbg.json debugger only ever targets the local dev server, so pin its host to
# localhost/127.0.0.1. (Applied only to the .qdbg.json path, not an explicit <url>.)
require_local_host() {
	local rest="${1#http://}"
	rest="${rest#https://}"
	local host="${rest%%[/:]*}"
	case "$host" in
		localhost|127.0.0.1) : ;;
		*) die "./.qdbg.json url must target localhost or 127.0.0.1 (got host '${host}')" ;;
	esac
}

# Probe the Vite dev-server port range; echo the first live port (empty if none).
detect_port() {
	local p
	for p in 3050 3051 3052 3053 3054 3055; do
		if curl -s "http://localhost:${p}" >/dev/null 2>&1; then echo "$p"; return 0; fi
	done
	return 0
}

# Resolve the connect URL WITHOUT side effects (no dev-server start, no browser).
# Powers the --print-url dry run and the .qdbg.json / explicit-URL fast paths.
#   (no arg) + ./.qdbg.json  → json.url + /?debug          (scaffolded single-page project, D5)
#   <url>                    → url + ?debug
#   <demo-name> | (no arg)   → http://localhost:<port>/<demo>/?debug   (monorepo multi-page)
# With no live dev server the port defaults to 3050 so a dry run still resolves.
resolve_connect_url() {
	# No argument and a project ./.qdbg.json → use its root URL (scaffold case, D5).
	# bin/qdbg carries no jq, but Node is guaranteed in any Quintus project.
	if [ $# -eq 0 ] && [ -f "./.qdbg.json" ]; then
		local base
		# process.stdout.write(String(...)) — NOT console.log: console.log routes an
		# absent field through util.inspect, which under FORCE_COLOR (set by Claude Code)
		# prints an ANSI-wrapped "undefined" that defeats the empty-field guard below.
		base="$(node -e 'process.stdout.write(String(require("./.qdbg.json").url ?? ""))')" \
			|| die "Could not parse ./.qdbg.json"
		if [ -z "$base" ]; then
			die "./.qdbg.json is missing a \"url\" field"
		fi
		require_http_url "$base"
		require_local_host "$base"
		append_debug "${base%/}/"
		return 0
	fi

	local demo="${1:-platformer}"
	if [[ "$demo" == http* ]]; then
		require_http_url "$demo"
		append_debug "$demo"
		return 0
	fi

	local port
	port="$(detect_port)"
	if [ -z "$port" ]; then port=3050; fi
	echo "http://localhost:${port}/${demo}/?debug"
}

cmd_connect() {
	# Dry run: print the resolved URL and exit (no playwright, no dev server, no browser).
	if [ "${1:-}" = "--print-url" ]; then
		shift
		resolve_connect_url "$@"
		return 0
	fi

	check_playwright_cli

	local url=""

	# Fast paths that need no monorepo port probe / auto-start:
	#   • no arg + ./.qdbg.json  → the scaffold's root URL (D5)
	#   • an explicit <url> arg
	if { [ $# -eq 0 ] && [ -f "./.qdbg.json" ]; } || [[ "${1:-}" == http* ]]; then
		url="$(resolve_connect_url "$@")"
	else
		# Monorepo multi-page layout: probe for the dev server, auto-start if needed.
		local demo="${1:-platformer}"
		local port
		port="$(detect_port)"

		echo "Starting dev server if needed..."
		if [ -z "$port" ]; then
			echo "Dev server not running. Starting pnpm dev in background..."
			(cd "$QROOT" && pnpm dev &>/dev/null &)
			for i in $(seq 1 30); do
				port="$(detect_port)"
				if [ -n "$port" ]; then break; fi
				sleep 0.5
			done
			if [ -z "$port" ]; then
				die "Dev server failed to start after 15 seconds"
			fi
			echo "Dev server ready on port ${port}."
		else
			echo "Dev server already running on port ${port}."
		fi
		url="http://localhost:${port}/${demo}/?debug"
	fi

	echo "Opening browser at ${url}..."
	# $url is guaranteed to start with http(s):// (require_http_url on every url-bearing
	# path, or a fixed http://localhost prefix in the monorepo branch), so it can never be
	# parsed as a leading-"-" flag by playwright-cli — the argument-injection guard.
	$PC open "$url"

	sleep 0.5
	local check
	check=$(qeval "typeof window.__quintusDebug !== 'undefined' ? 'bridge_ok' : 'no_bridge'" 2>/dev/null || echo "error")
	if echo "$check" | grep -q "bridge_ok"; then
		echo "Debug bridge connected."
		cmd_status
	else
		echo "Warning: Debug bridge not detected. Is ?debug in the URL?"
	fi
}

cmd_disconnect() {
	$PC close
	echo "Browser session closed."
}

cmd_status() {
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		return 'Frame: ' + d.frame + '  Elapsed: ' + d.elapsed.toFixed(3) + 's  Paused: ' + d.paused;
	"
}

cmd_tree() {
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var snap = d.tree();
		if (!snap) return '(no scene)';
		return f.formatTree(snap);
	"
}

cmd_layout() {
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var snap = d.tree();
		if (!snap) return '(no scene)';
		return f.formatLayout(snap);
	"
}

cmd_inspect() {
	local target="${1:?Usage: qdbg inspect <name|id>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var snap = d.inspect('${target}');
		if (!snap) snap = d.inspect(Number('${target}'));
		if (!snap) return 'Node not found: ${target}';
		return JSON.stringify(snap, null, 2);
	"
}

cmd_query() {
	local q="${1:?Usage: qdbg query <type|name|tag>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var results = d.query('${q}');
		return f.formatQueryResults(results, '${q}');
	"
}

cmd_physics() {
	local target="${1:?Usage: qdbg physics <name>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var snap = d.inspect('${target}');
		if (!snap) return 'Node not found: ${target}';
		return f.formatPhysics(snap);
	"
}

cmd_step() {
	local n="${1:-1}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		d.step(${n});
		return 'Stepped ' + ${n} + ' frame(s). Now at frame ' + d.frame + '  Elapsed: ' + d.elapsed.toFixed(3) + 's';
	"
}

cmd_pause() {
	need_bridge
	qblock "window.__quintusDebug.pause(); return 'Paused at frame ' + window.__quintusDebug.frame;"
}

cmd_resume() {
	need_bridge
	qblock "window.__quintusDebug.resume(); return 'Resumed from frame ' + window.__quintusDebug.frame;"
}

cmd_scene() {
	local name="${1:?Usage: qdbg scene <name>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		d.switchScene('${name}');
		return 'Switched to scene: ${name}. Frame: ' + d.frame;
	"
}

cmd_scenes() {
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var names = d.listScenes();
		if (names.length === 0) return '(no scenes registered)';
		return 'Registered scenes:\n' + names.map(function(n) { return '  - ' + n; }).join('\n');
	"
}

cmd_eval() {
	local code="${1:?Usage: qdbg eval '<code>'}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var game = window.__quintusGame;
		var result = (${code});
		if (result === undefined) return '(undefined)';
		if (result === null) return '(null)';
		if (typeof result === 'object') return JSON.stringify(result, null, 2);
		return String(result);
	"
}

cmd_actions() {
	need_bridge
	qblock "
		var actions = window.__quintusDebug.listActions();
		if (actions.length === 0) return '(no input actions registered)';
		return 'Available actions:\n' + actions.map(function(a) { return '  - ' + a; }).join('\n');
	"
}

cmd_press() {
	local action="${1:?Usage: qdbg press <action>}"
	need_bridge
	qblock "window.__quintusDebug.press('${action}'); return 'Pressed: ${action}';"
}

cmd_release() {
	local action="${1:?Usage: qdbg release <action>}"
	need_bridge
	qblock "window.__quintusDebug.release('${action}'); return 'Released: ${action}';"
}

cmd_release_all() {
	need_bridge
	qblock "window.__quintusDebug.releaseAll(); return 'All actions released.';"
}

cmd_tap() {
	local action="${1:?Usage: qdbg tap <action> [frames]}"
	local frames="${2:-1}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		d.pressAndStep('${action}', ${frames});
		return 'Tapped ${action} for ${frames} frame(s). Now at frame ' + d.frame;
	"
}

cmd_click() {
	local x="${1:?Usage: qdbg click <x> <y>}"
	local y="${2:?Usage: qdbg click <x> <y>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var hit = d.click(${x}, ${y});
		return hit ? 'Clicked at (${x}, ${y})' : 'No interactive node at (${x}, ${y})';
	"
}

cmd_click_button() {
	local name="${1:?Usage: qdbg click-button <name|text>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var found = d.clickButton('${name}');
		return found ? 'Clicked button: ${name}' : 'Button not found: ${name}';
	"
}

cmd_run() {
	local json="${1:?Usage: qdbg run '<json>'}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var script = ${json};
		var snaps = d.run(script);
		return 'Ran ' + script.length + ' action(s), ' + snaps.length + ' snapshot(s). Frame: ' + d.frame;
	"
}

cmd_events() {
	need_bridge
	local category="" search="" limit="" from_frame="" to_frame=""
	for arg in "$@"; do
		case "$arg" in
			--category=*) category="${arg#*=}" ;;
			--search=*)   search="${arg#*=}" ;;
			--limit=*)    limit="${arg#*=}" ;;
			--from=*)     from_frame="${arg#*=}" ;;
			--to=*)       to_frame="${arg#*=}" ;;
		esac
	done
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var filter = {};
		if ('${category}') filter.category = '${category}';
		if ('${search}') filter.search = '${search}';
		if ('${limit}') filter.limit = Number('${limit}');
		if ('${from_frame}') filter.fromFrame = Number('${from_frame}');
		if ('${to_frame}') filter.toFrame = Number('${to_frame}');
		var events = d.events(Object.keys(filter).length > 0 ? filter : undefined);
		return f.formatEvents(events);
	"
}

cmd_peek() {
	need_bridge
	local category="" search="" limit="" from_frame="" to_frame=""
	for arg in "$@"; do
		case "$arg" in
			--category=*) category="${arg#*=}" ;;
			--search=*)   search="${arg#*=}" ;;
			--limit=*)    limit="${arg#*=}" ;;
			--from=*)     from_frame="${arg#*=}" ;;
			--to=*)       to_frame="${arg#*=}" ;;
		esac
	done
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var filter = {};
		if ('${category}') filter.category = '${category}';
		if ('${search}') filter.search = '${search}';
		if ('${limit}') filter.limit = Number('${limit}');
		if ('${from_frame}') filter.fromFrame = Number('${from_frame}');
		if ('${to_frame}') filter.toFrame = Number('${to_frame}');
		var events = d.peekEvents(Object.keys(filter).length > 0 ? filter : undefined);
		return f.formatEvents(events);
	"
}

cmd_clear_events() {
	need_bridge
	qblock "window.__quintusDebug.clearEvents(); return 'Events cleared.';"
}

cmd_track() {
	local target="${1:?Usage: qdbg track <name> [frames]}"
	local frames="${2:-30}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var result = d.track('${target}', ${frames});
		return f.formatTrack(result);
	"
}

cmd_jump_analysis() {
	local target="${1:?Usage: qdbg jump-analysis <name>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var result = d.jumpAnalysis('${target}');
		if (typeof result === 'string') return result;
		return f.formatJumpAnalysis(result, '${target}');
	"
}

cmd_move_to() {
	local target="${1:?Usage: qdbg move-to <node> <actions> <x> <y> [--max=N]}"
	local actions="${2:?Usage: qdbg move-to <node> <actions> <x> <y> [--max=N]}"
	local tx="${3:?Usage: qdbg move-to <node> <actions> <x> <y> [--max=N]}"
	local ty="${4:?Usage: qdbg move-to <node> <actions> <x> <y> [--max=N]}"
	shift 4 || true
	local max_frames=600
	for arg in "$@"; do
		case "$arg" in
			--max=*) max_frames="${arg#*=}" ;;
		esac
	done
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var result = d.moveTo({
			target: '${target}',
			actions: '${actions}'.split(','),
			targetX: '${tx}' === '-' ? null : Number('${tx}'),
			targetY: '${ty}' === '-' ? null : Number('${ty}'),
			maxFrames: ${max_frames}
		});
		if (typeof result === 'string') return result;
		var floor = result.onFloor ? ' [floor]' : '';
		if (result.reached) {
			return 'Reached (' + result.endX.toFixed(2) + ', ' + result.endY.toFixed(2) + ') in ' + result.frames + ' frames. vel=(' + result.endVx.toFixed(2) + ', ' + result.endVy.toFixed(2) + ')' + floor + '  Frame: ' + result.bridgeFrame;
		} else {
			return 'Stopped at (' + result.endX.toFixed(2) + ', ' + result.endY.toFixed(2) + ') after ' + result.frames + ' frames (limit). vel=(' + result.endVx.toFixed(2) + ', ' + result.endVy.toFixed(2) + ')' + floor + '  Frame: ' + result.bridgeFrame;
		}
	"
}

cmd_nearby() {
	local target="${1:?Usage: qdbg nearby <name> [radius]}"
	local radius="${2:-100}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var result = d.nearby('${target}', ${radius});
		if (typeof result === 'string') return result;
		return f.formatNearby(result);
	"
}

cmd_destroy() {
	local target="${1:?Usage: qdbg destroy <name|id|type|tag>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var key = Number('${target}');
		var count = isNaN(key) ? d.destroy('${target}') : d.destroy(key);
		if (count === 0) return 'No nodes matched: ${target}';
		return 'Destroyed ' + count + ' node(s) matching: ${target}';
	"
}

cmd_mouse() {
	local x="${1:?Usage: qdbg mouse <x> <y>}"
	local y="${2:?Usage: qdbg mouse <x> <y>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		d.setMousePosition(${x}, ${y});
		return 'Mouse position set to (${x}, ${y})';
	"
}

cmd_mouse_get() {
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var pos = d.getMousePosition();
		return 'Mouse position: (' + pos.x.toFixed(2) + ', ' + pos.y.toFixed(2) + ')';
	"
}

cmd_bones() {
	local target="${1:?Usage: qdbg bones <name|id>}"
	local safe_target="${target//\'/\\\'}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var game = window.__quintusGame;
		var snap = d.inspect('${safe_target}');
		if (!snap) snap = d.inspect(Number('${safe_target}'));
		if (!snap) return 'Node not found: ${safe_target}';
		var scene = game.currentScene;
		if (!scene) return 'No active scene';
		var node = null;
		function findById(n, id) {
			if (n.id === id) return n;
			var kids = n.children || [];
			for (var i = 0; i < kids.length; i++) {
				var found = findById(kids[i], id);
				if (found) return found;
			}
			return null;
		}
		node = findById(scene, snap.id);
		if (!node || !node.object3d) return 'Node has no object3d: ${safe_target}';
		node.object3d.updateMatrixWorld(true);
		var lines = [];
		function walk(obj, depth) {
			var indent = '';
			for (var i = 0; i < depth; i++) indent += '  ';
			var isBone = obj.isBone || (obj.type && obj.type === 'Bone');
			var marker = isBone ? '* ' : '  ';
			var lp = obj.position;
			var wp = new (Object.getPrototypeOf(lp).constructor)(0, 0, 0);
			if (obj.getWorldPosition) { obj.getWorldPosition(wp); }
			else { wp.x = lp.x; wp.y = lp.y; wp.z = lp.z; }
			var name = obj.name || obj.type || '(unnamed)';
			var childCount = obj.children ? obj.children.length : 0;
			lines.push(indent + marker + name +
				'  local=(' + lp.x.toFixed(3) + ', ' + lp.y.toFixed(3) + ', ' + lp.z.toFixed(3) + ')' +
				'  world=(' + wp.x.toFixed(3) + ', ' + wp.y.toFixed(3) + ', ' + wp.z.toFixed(3) + ')' +
				'  [' + childCount + ' children]');
			if (obj.children) {
				for (var c = 0; c < obj.children.length; c++) walk(obj.children[c], depth + 1);
			}
		}
		walk(node.object3d, 0);
		return lines.join('\n');
	"
}

cmd_bone_info() {
	local target="${1:?Usage: qdbg bone-info <name|id> <bone-name>}"
	local bone_name="${2:?Usage: qdbg bone-info <name|id> <bone-name>}"
	local safe_target="${target//\'/\\\'}"
	local safe_bone="${bone_name//\'/\\\'}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var game = window.__quintusGame;
		var snap = d.inspect('${safe_target}');
		if (!snap) snap = d.inspect(Number('${safe_target}'));
		if (!snap) return 'Node not found: ${safe_target}';
		var scene = game.currentScene;
		if (!scene) return 'No active scene';
		function findById(n, id) {
			if (n.id === id) return n;
			var kids = n.children || [];
			for (var i = 0; i < kids.length; i++) {
				var found = findById(kids[i], id);
				if (found) return found;
			}
			return null;
		}
		var node = findById(scene, snap.id);
		if (!node || !node.object3d) return 'Node has no object3d: ${safe_target}';
		node.object3d.updateMatrixWorld(true);
		var bone = node.object3d.getObjectByName('${safe_bone}');
		if (!bone) return 'Bone not found: ${safe_bone}';
		var lp = bone.position;
		var wp = new (Object.getPrototypeOf(lp).constructor)(0, 0, 0);
		if (bone.getWorldPosition) bone.getWorldPosition(wp);
		else { wp.x = lp.x; wp.y = lp.y; wp.z = lp.z; }
		var r = bone.rotation;
		var q = bone.quaternion;
		var s = bone.scale;
		var parentName = bone.parent ? (bone.parent.name || bone.parent.type || '(unnamed)') : '(none)';
		var childNames = (bone.children || []).map(function(c) { return c.name || c.type || '(unnamed)'; });
		return JSON.stringify({
			name: bone.name,
			localPosition: { x: lp.x, y: lp.y, z: lp.z },
			worldPosition: { x: wp.x, y: wp.y, z: wp.z },
			rotation: { x: r.x, y: r.y, z: r.z, order: r.order },
			quaternion: { x: q.x, y: q.y, z: q.z, w: q.w },
			scale: { x: s.x, y: s.y, z: s.z },
			parent: parentName,
			children: childNames
		}, null, 2);
	"
}

cmd_screenshot() {
	local file="${1:-/tmp/quintus-screenshot.png}"
	need_bridge
	qrun "async page => {
		const canvas = page.locator('canvas');
		await canvas.screenshot({ path: '${file}' });
		return 'Screenshot saved to ${file}';
	}"
}

cmd_transform() {
	local target="${1:?Usage: qdbg transform <name|id>}"
	need_bridge
	qblock "
		var d = window.__quintusDebug;
		var f = window.__quintusFormatters;
		var result = d.transform('${target}');
		if (typeof result === 'string') {
			result = d.transform(Number('${target}'));
		}
		if (typeof result === 'string') return result;
		return f.formatTransform(result);
	"
}

