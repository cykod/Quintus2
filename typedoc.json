{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": [
		"packages/quintus2",
		"packages/audio",
		"packages/camera",
		"packages/core",
		"packages/debug",
		"packages/headless",
		"packages/input",
		"packages/jsx",
		"packages/math",
		"packages/mcp",
		"packages/particles",
		"packages/physics",
		"packages/prefabs",
		"packages/quintus-core",
		"packages/snapshot",
		"packages/sprites",
		"packages/test",
		"packages/three",
		"packages/tilemap",
		"packages/touch",
		"packages/tween",
		"packages/ui"
	],
	"entryPointStrategy": "packages",
	"sortEntryPoints": false,
	"exclude": ["**/packages/create-quintus2"],
	"projectDocuments": ["packages/quintus2/docs/embedding.md"],
	"out": "docs/api",
	"name": "Quintus 2.0",
	"readme": "README.md",
	"excludePrivate": true,
	"excludeInternal": true,
	"includeVersion": true,
	"highlightLanguages": [
		"bash",
		"console",
		"css",
		"html",
		"javascript",
		"json",
		"jsonc",
		"json5",
		"tsx",
		"typescript",
		"xml",
		"yaml"
	],
	"packageOptions": {
		"excludePrivate": true,
		"excludeInternal": true,
		"entryPoints": ["src/index.ts"],
		"exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.test-d.ts", "**/__test-utils__/**"],
		"skipErrorChecking": true,
		"suppressCommentWarningsInDeclarationFiles": true,
		"validation": { "notExported": false, "invalidLink": true, "notDocumented": false }
	}
}
